# Supabase (projeto próprio deste app -- NÃO o do plataforma-agencia)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apify (coleta Google Maps -- ator compass/crawler-google-places)
APIFY_TOKEN=
# Secret compartilhado na query string do webhook do Apify
# (?secret=...) -- gere uma string aleatória qualquer.
APIFY_WEBHOOK_SECRET=

# Job de rede de segurança (app/api/cron/poll-scrape-runs) -- header
# x-cron-secret ou Authorization: Bearer <CRON_SECRET>, injetado
# automaticamente pelo Vercel Cron.
CRON_SECRET=

# Resend (e-mail automatizado) -- exige domínio verificado no dashboard do
# Resend (SPF/DKIM/DMARC) antes de funcionar de verdade; sem isso o envio
# fica em modo no-op (loga aviso, não quebra a rota).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_UNSUBSCRIBE_SECRET=

# Notion (Kanban "🎯 Leads Qualificados" dentro do Hub Central) -- token de
# uma integração INTERNA do Notion (Configurações → Conexões → Desenvolver
# ou gerenciar integrações → Nova integração), depois compartilhar a base
# com essa integração ("•••" na base → Conexões).
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=

# CTA de agendamento nos e-mails/templates (Calendly ou Cal.com).
NEXT_PUBLIC_SCHEDULING_LINK=

# Nome da agência, usado no rodapé LGPD dos e-mails.
NEXT_PUBLIC_AGENCY_NAME=

# URL pública do app em produção (usada pra montar o webhook do Apify e os
# links "Link no App" no Notion). Em dev local pode deixar vazio -- o app
# usa a origem da própria requisição como fallback.
NEXT_PUBLIC_APP_URL=
